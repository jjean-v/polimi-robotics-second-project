include "scout_mini.inc"

define floorplan model (
  color "gray30" boundary 1 gui_nose 0 gui_grid 0 gui_outline 0 gripper_return 0 fiducial_return 0 ranger_return 1
)

resolution 0.05
interval_sim 100

window ( size [ 800.0 800.0 ] center [ 0.0 0.0 ] rotate [ 0.0 0.0 ] scale 60 )

floorplan (
  name "map"
  bitmap "../map/my_map.png"
  size [ 30.85 17.75 2.0 ]    # Adjust according to your SLAM map size
  pose [ 0.0 0.0 0.0 0.0 ]
)

scout_mini (
  pose [ 0.0 0.0 0.0 0.0 ]  # Initial spawn location
  name "scout_mini"
)